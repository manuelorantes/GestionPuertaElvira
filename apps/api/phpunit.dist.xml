<?xml version="1.0" encoding="UTF-8"?>
<!-- Suites por capa (ver specs/decisions/integracion-continua-y-puertas-de-calidad.md). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         beStrictAboutOutputDuringTests="true"
         beStrictAboutCoverageMetadata="false"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnWarning="true"
         failOnRisky="true"
         displayDetailsOnTestsThatTriggerDeprecations="true"
         displayDetailsOnTestsThatTriggerNotices="true"
         displayDetailsOnTestsThatTriggerWarnings="true">
    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <server name="APP_ENV" value="test" force="true"/>
        <!-- debug=1: la caché del contenedor se regenera al cambiar la configuración. -->
        <server name="APP_DEBUG" value="1" force="true"/>
        <server name="APP_SECRET" value="test-secret-not-for-production"/>
        <server name="SESSION_COOKIE_NAME" value="pe_session"/>
        <server name="SESSION_COOKIE_SECURE" value="0"/>
        <server name="KERNEL_CLASS" value="App\Infrastructure\Kernel"/>
        <server name="SHELL_VERBOSITY" value="-1"/>
    </php>

    <testsuites>
        <testsuite name="domain">
            <directory>tests/Domain</directory>
        </testsuite>
        <testsuite name="application">
            <directory>tests/Application</directory>
        </testsuite>
        <testsuite name="infrastructure">
            <directory>tests/Infrastructure</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <source ignoreSuppressionOfDeprecations="true">
        <include>
            <directory>src</directory>
        </include>
        <exclude>
            <file>src/Infrastructure/Kernel.php</file>
        </exclude>
    </source>

    <extensions>
        <bootstrap class="DAMA\DoctrineTestBundle\PHPUnit\PHPUnitExtension"/>
    </extensions>
</phpunit>
