{
  "imports": {
    "@hono/hono": "jsr:@hono/hono@^4.13.13",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/testing": "jsr:@std/testing@^1.0.21",
    "hash-wasm": "npm:hash-wasm@^4.12.0",
    "postgres": "npm:postgres@^3.4.9",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.117.2"
  },
  "tasks": {
    "serve": "deno run --allow-net --allow-env --allow-read --allow-write --watch index.ts",
    "test": "deno test --allow-net --allow-env --allow-read --allow-write",
    "coverage": "deno test --allow-net --allow-env --allow-read --allow-write --coverage=.coverage && deno coverage .coverage --lcov --output=.coverage/lcov.info",
    "check": "deno fmt --check && deno lint && deno check index.ts scripts tests",
    "fix": "deno fmt && deno lint --fix",
    "migrate": "deno run --allow-net --allow-env --allow-read scripts/migrate.ts",
    "console": "deno run --allow-net --allow-env --allow-read --allow-write scripts/console.ts"
  },
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ],
      "include": [
        "no-explicit-any",
        "eqeqeq"
      ]
    }
  },
  "fmt": {
    "lineWidth": 100,
    "singleQuote": true,
    "semiColons": true,
    "proseWrap": "preserve"
  },
  "exclude": [
    ".coverage",
    ".storage"
  ]
}
