// Esquema de la base de datos (fuente documental; ver specs/decisions/postgresql-con-doctrine-y-modelos-de-persistencia-separados.md).
// Se actualiza con cada migración.
Project puerta_elvira {
  database_type: 'PostgreSQL'
  Note: 'Gestión del Club Ajedrez Puerta Elvira'
}

// --- Identity -----------------------------------------------------------

Table identity_user {
  id uuid [pk, note: 'UUIDv7']
  email varchar(254) [not null, unique, note: 'normalizado a minúsculas']
  full_name varchar(120) [not null]
  role varchar(20) [not null, note: 'superadministrator | administrator | teacher | assistant']
  password_hash varchar(255) [not null]
  status varchar(20) [not null, note: 'active | disabled']
  must_change_password boolean [not null, note: 'true tras alta o restablecimiento']
  created_at timestamptz [not null]
  password_changed_at timestamptz [not null]
  teacher_id uuid [unique, note: 'profesor de una cuenta de profesorado (solo rol teacher); uno por cuenta']
}

Ref: identity_user.teacher_id - teachers_teacher.id [delete: set null]

Table identity_session {
  id uuid [pk, note: 'UUIDv7']
  token_hash varchar(64) [not null, unique, note: 'SHA-256 del token de la cookie; el token nunca se guarda']
  user_id uuid [not null, note: 'referencia por identidad a identity_user.id (sin FK: agregados independientes)']
  started_at timestamptz [not null]
  last_activity_at timestamptz [not null]

  indexes {
    user_id [name: 'identity_session_user_idx']
  }
}

Ref: identity_session.user_id > identity_user.id

// --- Alumnado -------------------------------------------------------------

Table students_student {
  id uuid [pk, note: 'UUIDv7']
  full_name varchar(120) [not null]
  search_name varchar(120) [not null, note: 'nombre en minúsculas y sin tildes para la búsqueda']
  birth_date date [not null]
  national_id varchar(9) [note: 'DNI o NIE con letra de control']
  contact_email varchar(254)
  guardians json [not null, note: 'lista de 0 a 2 {name, phone}']
  own_phone varchar(12)
  federation_licence varchar(20) [note: 'su presencia indica federado']
  image_consent boolean [not null]
  joined_on date [not null]
  withdrawn_on date [note: 'baja (no activo desde ese día)']
  sibling_ids json [not null, note: 'ids de hermanos; relación mutua']

  indexes {
    search_name [name: 'students_student_search_idx']
  }
}

Ref: classes_enrolment.student_id > students_student.id

// --- Profesorado ---------------------------------------------------------

Table teachers_teacher {
  id uuid [pk, note: 'UUIDv7']
  full_name varchar(120) [not null]
  hourly_rate_cents int [not null, default: 1500, note: 'lo que el club le paga por hora']
  active boolean [not null]
}

// --- Clases ---------------------------------------------------------------

Table classes_group {
  id uuid [pk, note: 'UUIDv7']
  name varchar(60) [not null]
  level varchar(20) [not null, note: 'beginner | intermediate | advanced | juniors | adults | private_lesson']
  teacher_id uuid [not null, note: 'referencia por identidad a teachers_teacher.id']
  days json [not null, note: 'días ISO 1–5 (lunes–viernes), ordenados']
  start_minutes smallint [not null, note: 'minutos desde medianoche, 960–1260, múltiplo de 30']
  end_minutes smallint [not null, note: 'mayor que start_minutes']
  classroom smallint [not null, note: '1 | 2']
  capacity smallint [not null, note: '1–30']

  indexes {
    teacher_id [name: 'classes_group_teacher_idx']
  }
}

Table classes_enrolment {
  id uuid [pk, note: 'UUIDv7']
  student_id uuid [not null, note: 'referencia por identidad al alumno (contexto Alumnado)']
  class_group_id uuid [not null, note: 'referencia por identidad a classes_group.id']
  enrolled_on date [not null]
  ends_on date [note: 'fin no incluido; nulo = vigente']

  indexes {
    student_id [name: 'classes_enrolment_student_idx']
    class_group_id [name: 'classes_enrolment_group_idx']
  }
}

Ref: classes_group.teacher_id > teachers_teacher.id
Ref: classes_enrolment.class_group_id > classes_group.id

// --- Cobros (Billing) -----------------------------------------------------

Table billing_settings {
  id varchar(20) [pk, note: "una sola fila: 'club'"]
  data json [not null, note: 'tarifas, descuentos, precios por hora de particulares y datos fiscales (importes en céntimos)']
}

Table billing_account {
  student_id uuid [pk, note: 'referencia por identidad al alumno']
  preferred_plan varchar(20) [not null, note: 'monthly | three_months | six_months | rest_of_season (solo propone meses)']
  member boolean [not null, note: 'socio: cuota de socio por temporada']
  private_rate_cents int [note: 'precio por hora pactado de sus particulares']
  points int [not null, note: 'contador manual, ≥ 0']
}

Table billing_charge {
  id uuid [pk, note: 'UUIDv7']
  student_id uuid [not null]
  kind varchar(12) [not null, note: 'monthly | membership']
  period varchar(7) [not null, note: 'AAAA-MM; en las de socio, septiembre de la temporada']
  amount_cents int [not null, note: 'fijado al generarla']
  paid_by uuid [note: 'billing_payment.id; nulo = sin pagar']
  reminded_on date [note: 'último aviso por WhatsApp']

  indexes {
    (student_id, kind, period) [unique, name: 'billing_charge_unique']
    period [name: 'billing_charge_period_idx']
  }
}

Table billing_payment {
  id uuid [pk, note: 'UUIDv7']
  student_id uuid [not null]
  paid_on date [not null]
  method varchar(10) [not null, note: 'cash | transfer']
  receipt_number varchar(16) [unique, not null, note: 'R-AAAA-NNNN por temporada']
  kind varchar(12) [not null]
  concept varchar(120) [not null]
  lines json [not null, note: 'desglose [{label, amountCents}]; suma = total']
  total_cents int [not null]
  periods json [not null, note: 'meses cubiertos AAAA-MM']
  invoice_number varchar(16) [unique, note: 'F-AAAA-NNNN si se emitió factura']
  invoice json [note: 'cliente, base, IVA 21 % incluido y total']

  indexes {
    student_id [name: 'billing_payment_student_idx']
  }
}

Table billing_document_sequence {
  prefix varchar(1) [not null, note: 'R (recibo) | F (factura)']
  season_year smallint [not null]
  last_value int [not null]

  indexes {
    (prefix, season_year) [pk]
  }
}

Ref: billing_charge.paid_by > billing_payment.id

// --- Profesorado (Payroll) ------------------------------------------------

Table payroll_session {
  id uuid [pk, note: 'UUIDv7']
  teacher_id uuid [not null, note: 'quién la imparte (sustituciones incluidas)']
  session_date date [not null]
  group_id uuid [note: 'nulo = otra actividad']
  label varchar(80) [not null, note: 'nombre del grupo o de la actividad']
  minutes smallint [not null, note: '30–720, múltiplo de 30']
  from_schedule boolean [not null, note: 'propuesta desde el horario o añadida a mano']

  indexes {
    session_date [name: 'payroll_session_date_idx']
  }
}

Table payroll_settlement {
  teacher_id uuid [not null]
  month varchar(7) [not null, note: 'AAAA-MM']
  minutes int [not null]
  rate_cents int [not null, note: 'tarifa congelada al pagar']
  amount_cents int [not null]
  lines json [not null, note: 'detalle por grupo [{label, minutes, amountCents}]']
  paid_on date [not null]

  indexes {
    (teacher_id, month) [pk]
  }
  Note: 'Solo existe cuando la liquidación está pagada; bloquea las sesiones de ese profesor y mes'
}

Table payroll_proposed_month {
  month varchar(7) [pk, note: 'meses ya propuestos desde el horario']
}

// --- Contabilidad (Accounting) ---------------------------------------------

Table accounting_entry {
  id uuid [pk, note: 'apunte manual (subvención, comisión, venta…)']
  entry_date date [not null]
  kind varchar(10) [not null, note: 'income | expense']
  concept varchar(120) [not null]
  category varchar(20) [not null, note: 'categoría fija coherente con el tipo']
  method varchar(10) [not null, note: 'cash | transfer | card']
  amount_cents int [not null, note: '> 0']

  indexes {
    entry_date [name: 'accounting_entry_date_idx']
  }
}

Table accounting_invoice {
  id uuid [pk]
  invoice_date date [not null]
  number varchar(40) [not null]
  supplier varchar(120) [not null]
  concept varchar(120) [not null]
  category varchar(20) [not null, note: 'categoría de gasto']
  amount_cents int [not null]
  paid_on date [note: 'nulo = pendiente; cuenta como gasto en esta fecha']
  method varchar(10)
  attachment_key varchar(200) [note: 'clave en el almacenamiento de documentos']
  attachment_name varchar(200)
  attachment_type varchar(40) [note: 'application/pdf | image/jpeg | image/png | image/webp']
  attachment_bytes int [note: '≤ 10 MB']

  indexes {
    paid_on [name: 'accounting_invoice_paid_idx']
  }
}

Table accounting_closing {
  start_year smallint [pk, note: 'ejercicio de septiembre de start_year a agosto siguiente']
  income_cents int [not null]
  expense_cents int [not null]
  closed_on date [not null]
  Note: 'Bloquea todo lo fechado en el ejercicio; su resultado pasa como saldo inicial del siguiente'
}

Note libro {
  'El libro de movimientos no tiene tabla propia: se compone en lectura con billing_payment, payroll_settlement, accounting_invoice pagadas y accounting_entry.'
}

// --- Historial (Audit) ------------------------------------------------------

Table audit_action {
  id uuid [pk, note: 'una petición de la web, una transacción de consola, un evento de seguridad o una reversión']
  seq bigserial [unique, not null, note: 'orden del historial']
  kind varchar(12) [not null, note: 'change | security | undo | restore']
  user_id uuid [note: 'quién (nulo = Sistema)']
  user_name varchar(120) [not null, note: 'nombre en ese momento']
  label varchar(160) [not null, note: 'p. ej. «Registrar cobro»']
  occurred_at timestamptz [not null]
  reverts uuid [note: 'acción que deshace o punto al que vuelve']
}

Table audit_change {
  id bigserial [pk]
  action_id uuid [not null]
  table_name varchar(63) [not null]
  row_key jsonb [not null, note: 'clave primaria de la fila']
  operation char(1) [not null, note: 'I | U | D']
  before jsonb [note: 'fila completa antes']
  after jsonb [note: 'fila completa después']

  indexes {
    action_id [name: 'audit_change_action_idx']
    (table_name, row_key) [name: 'audit_change_row_idx']
  }
  Note: 'Lo rellena el trigger audit_capture de cada tabla de datos; audit_revert_change revierte un cambio'
}

Ref: audit_change.action_id > audit_action.id

// --- Infraestructura ----------------------------------------------------

Table cache_items {
  item_id varchar(255) [pk]
  item_data bytea [not null]
  item_lifetime int
  item_time int [not null]
  Note: 'Almacén compartido del limitador de intentos de inicio de sesión'
}

// ---- Asistencia -------------------------------------------------------------------------------

Table attendance_roll_call {
  group_id uuid [not null]
  roll_date date [not null]
  kind varchar(20) [not null, note: 'taken (la pasó quien da la clase) | confirmed (administración la dio por buena sin lista)']
  taken_by_teacher uuid [note: 'profesor que la pasó']
  taken_by_user uuid [note: 'cuenta de administración que la dio por buena']
  taken_at timestamptz [not null]

  indexes {
    (group_id, roll_date) [pk]
  }
  Note: 'Lista de una clase un día. Se pasa desde que empieza la clase hasta el final del día siguiente.'
}

Table attendance_absence {
  group_id uuid [not null]
  roll_date date [not null]
  student_id uuid [not null]

  indexes {
    (group_id, roll_date, student_id) [pk]
    student_id
  }
  Note: 'Ausentes de una lista; el resto de alumnos de ese día vino.'
}

Table attendance_settings {
  id smallint [pk, note: 'siempre 1']
  since date [not null, note: 'primer día que cuenta para las listas sin pasar']
}

Ref: attendance_roll_call.group_id > classes_group.id [delete: cascade]
Ref: attendance_roll_call.taken_by_teacher > teachers_teacher.id [delete: set null]
Ref: attendance_roll_call.taken_by_user > identity_user.id [delete: set null]
Ref: attendance_absence.(group_id, roll_date) > attendance_roll_call.(group_id, roll_date) [delete: cascade]
Ref: attendance_absence.student_id > students_student.id [delete: cascade]
