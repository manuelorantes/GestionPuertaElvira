// Esquema de la base de datos (fuente documental; ver specs/decisions/postgresql-con-doctrine-y-modelos-de-persistencia-separados.md).
// Se actualiza con cada migración.
Project puerta_elvira {
  database_type: 'PostgreSQL'
  Note: 'Gestión del Club Ajedrez Puerta Elvira'
}

// --- Identity -----------------------------------------------------------

Table identity_user {
  id uuid [pk, note: 'UUIDv7']
  email varchar(254) [not null, unique, note: 'normalizado a minúsculas']
  full_name varchar(120) [not null]
  role varchar(20) [not null, note: 'administrator | teacher']
  password_hash varchar(255) [not null]
  status varchar(20) [not null, note: 'active | disabled']
  must_change_password boolean [not null, note: 'true tras alta o restablecimiento']
  created_at timestamptz [not null]
  password_changed_at timestamptz [not null]
}

Table identity_session {
  id uuid [pk, note: 'UUIDv7']
  token_hash varchar(64) [not null, unique, note: 'SHA-256 del token de la cookie; el token nunca se guarda']
  user_id uuid [not null, note: 'referencia por identidad a identity_user.id (sin FK: agregados independientes)']
  started_at timestamptz [not null]
  last_activity_at timestamptz [not null]

  indexes {
    user_id [name: 'identity_session_user_idx']
  }
}

Ref: identity_session.user_id > identity_user.id

// --- Alumnado -------------------------------------------------------------

Table students_student {
  id uuid [pk, note: 'UUIDv7']
  full_name varchar(120) [not null]
  search_name varchar(120) [not null, note: 'nombre en minúsculas y sin tildes para la búsqueda']
  birth_date date [not null]
  national_id varchar(9) [note: 'DNI o NIE con letra de control']
  contact_email varchar(254)
  guardians json [not null, note: 'lista de 0 a 2 {name, phone}']
  own_phone varchar(12)
  federation_licence varchar(20) [note: 'su presencia indica federado']
  image_consent boolean [not null]
  joined_on date [not null]
  withdrawn_on date [note: 'baja (no activo desde ese día)']
  sibling_ids json [not null, note: 'ids de hermanos; relación mutua']

  indexes {
    search_name [name: 'students_student_search_idx']
  }
}

Ref: classes_enrolment.student_id > students_student.id

// --- Profesorado ---------------------------------------------------------

Table teachers_teacher {
  id uuid [pk, note: 'UUIDv7']
  full_name varchar(120) [not null]
  active boolean [not null]
}

// --- Clases ---------------------------------------------------------------

Table classes_group {
  id uuid [pk, note: 'UUIDv7']
  name varchar(60) [not null]
  level varchar(20) [not null, note: 'beginner | intermediate | advanced | juniors | adults | private_lesson']
  teacher_id uuid [not null, note: 'referencia por identidad a teachers_teacher.id']
  days json [not null, note: 'días ISO 1–5 (lunes–viernes), ordenados']
  start_minutes smallint [not null, note: 'minutos desde medianoche, 960–1260, múltiplo de 30']
  end_minutes smallint [not null, note: 'mayor que start_minutes']
  classroom smallint [not null, note: '1 | 2']
  capacity smallint [not null, note: '1–30']

  indexes {
    teacher_id [name: 'classes_group_teacher_idx']
  }
}

Table classes_enrolment {
  id uuid [pk, note: 'UUIDv7']
  student_id uuid [not null, note: 'referencia por identidad al alumno (contexto Alumnado)']
  class_group_id uuid [not null, note: 'referencia por identidad a classes_group.id']
  enrolled_on date [not null]
  ends_on date [note: 'fin no incluido; nulo = vigente']

  indexes {
    student_id [name: 'classes_enrolment_student_idx']
    class_group_id [name: 'classes_enrolment_group_idx']
  }
}

Ref: classes_group.teacher_id > teachers_teacher.id
Ref: classes_enrolment.class_group_id > classes_group.id

// --- Infraestructura ----------------------------------------------------

Table cache_items {
  item_id varchar(255) [pk]
  item_data bytea [not null]
  item_lifetime int
  item_time int [not null]
  Note: 'Almacén compartido del limitador de intentos de inicio de sesión'
}
